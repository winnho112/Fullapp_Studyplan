{
  "buildCommand": "cd frontend && npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/auth", "destination": "/api/index.py" },
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/plans", "destination": "/api/index.py" },
    { "source": "/plans/:path*", "destination": "/api/index.py" },
    { "source": "/sessions", "destination": "/api/index.py" },
    { "source": "/sessions/:path*", "destination": "/api/index.py" }
  ]
}